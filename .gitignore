# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
.fvm/
lib/generated
example/lib/generated
examples/**/lib/generated

# Any directory named "generated", anywhere
**/generated/

# Server PID files
**/.server.pid

# Node
**/node_modules/

# Web related
lib/generated_plugin_registrant.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Examples — Java/Maven build artifacts
examples/**/target/

# Integration tests — Java build artifacts
integration_tests/**/*.jar
!integration_tests/**/gradle/wrapper/gradle-wrapper.jar
integration_tests/**/target/
integration_tests/**/.gradle/
integration_tests/**/build/

# Server integration tests — Gradle/Java build artifacts
server_integration_tests/**/*.jar
!server_integration_tests/**/gradle/wrapper/gradle-wrapper.jar
server_integration_tests/**/target/
server_integration_tests/**/.gradle/
server_integration_tests/**/build/
server_integration_tests/**/.server.pid

