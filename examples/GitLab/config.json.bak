{
    "schemaPaths": [
        "schema/*.graphql"
    ],
    "mode": "client",
    "identityFields": [],
    "typeMappings": {
        "ID": "String",
        "String": "String",
        "Float": "double",
        "Int": "int",
        "Boolean": "bool",
        "Null": "null",
        "AchievementsAchievementID": "String",
        "UserID": "String",
        "Upload": "int",
        "NamespaceID": "String",
        "UsersSavedReplyID": "String"


    },
    "outputDir": "lib/generated",
    "clientConfig": {
        "dart": {
            "packageName": "graphlink_gitlab_example",
            "generateAllFieldsFragments": true,
            "nullableFieldsRequired": false,
            "autoGenerateQueries": true,
            "autoGenerateQueriesDefaultAlias": "data",
            "operationNameAsParameter": false,
            "generateUiTypes": false,
            "generateUiInputs": false,
            "immutableInputFields": true,
            "immutableTypeFields": true,
            "httpAdapter": "dio"
        }
    }
}
