    "query": "{ a: errProbe(id: \"missing\") { id } }",
    "status": 200,
    "error": {"message": "Item missing not found", "path": ["a"], "extensions": {"code": "ErrNotFound", "id": "missing"}}
  },
  {
    "name": "graphql_plain_exception_stays_internal",
