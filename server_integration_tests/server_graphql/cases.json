    {"name": "hoist_optional_arg_omitted", "query": "{ catalog { products(category: \"c\", limit: 1) { id } } }",
     "expect": {"data": {"catalog": {"products": [{"id": "c-0"}]}}}},
    {"name": "hoist_defaulted_args_omitted", "query": "{ feed { id items { id } } }",
     "expect": {"data": {"feed": {"id": "feed1", "items": [{"id": "item-0"}, {"id": "item-1"}, {"id": "item-2"}, {"id": "item-3"}, {"id": "item-4"}, {"id": "item-5"}, {"id": "item-6"}, {"id": "item-7"}, {"id": "item-8"}, {"id": "item-9"}]}}}},
    {"name": "hoist_defaulted_args_given", "query": "{ feed { items(limit: 2, sort: \"z\") { id } } }",
     "expect": {"data": {"feed": {"items": [{"id": "z-0"}, {"id": "z-1"}]}}}},
    {"name": "hoist_nested_depths", "query": "{ store { id shelves(floor: 2) { id products(limit: 1) { id } } } }",
     "expect": {"data": {"store": {"id": "store1", "shelves": [{"id": "shelf-0", "products": [{"id": "shelf-0-0"}]}, {"id": "shelf-1", "products": [{"id": "shelf-1-0"}]}]}}}},
    {"name": "hoist_argument_named_field_args", "query": "{ search(fieldArgs: \"q\") { id hits(limit: 2) { id } } }",
     "expect": {"data": {"search": {"id": "q", "hits": [{"id": "hit-0"}, {"id": "hit-1"}]}}}},

    {"name": "intercept_root_operation", "query": "{ greetIntercepted(name: \"a\") { id message } }",
     "expect": {"data": {"greetIntercepted": {"id": "1", "message": "Hello, a(runBefore)"}}}},
    {"name": "intercept_is_opt_in", "query": "{ greetPlain(name: \"a\") { message } }",
     "expect": {"data": {"greetPlain": {"message": "Hello, a"}}}},
    {"name": "intercept_and_plain_in_one_request", "query": "{ p1: greetPlain(name: \"y\") { message } i: greetIntercepted(name: \"x\") { message } p2: greetPlain(name: \"z\") { message } }",
     "expect": {"data": {"p1": {"message": "Hello, y"}, "i": {"message": "Hello, x(runBefore)"}, "p2": {"message": "Hello, z"}}}},
    {"name": "intercept_mapping_allowed", "query": "{ listTeams { id name members(role: \"auth\") { id name } } }",
     "expect": {"data": {"listTeams": [{"id": "1", "name": "Core", "members": [{"id": "1", "name": "Ada"}, {"id": "2", "name": "Grace"}]}]}}},
    {"name": "intercept_mapping_denied", "query": "{ listTeams { members(role: \"guest\") { id } } }",
     "expect": {"errors": true, "data": null, "errorPath": ["listTeams", 0, "members"]}},
    {"name": "intercept_denied_does_not_poison_next_request", "query": "{ listTeams { members(role: \"auth\") { id } } }",
     "expect": {"data": {"listTeams": [{"members": [{"id": "1"}, {"id": "2"}]}]}}},

    {
      "name": "keywords_reserved_fields",
      "query": "{ reserved { __typename id class return new default is in with int synchronized native kind nested { __typename id value } secret { __typename id token } } }",
      "expect": {"data": {"reserved": {"__typename": "ReservedFields", "id": "r1", "class": "cls", "return": 42, "new": true, "default": "def", "is": "yes", "in": "inside", "with": "w", "int": 7, "synchronized": false, "native": "n", "kind": "class", "nested": {"__typename": "class", "id": "c1", "value": "v"}, "secret": {"__typename": "_Secret", "id": "s1", "token": "tok"}}}}
    },
    {"name": "keywords_colliding_fields_stay_separate", "query": "{ collide { id class class_ } }",
     "expect": {"data": {"collide": {"id": "1", "class": "A", "class_": "B"}}}},
    {"name": "keywords_reserved_operation_and_arguments", "query": "{ a: switch(class: \"x\", return: 5) { class return } b: switch(class: \"y\") { class return } }",
     "expect": {"data": {"a": {"class": "x", "return": 5}, "b": {"class": "y", "return": 0}}}},
    {"name": "keywords_reserved_arguments_from_variables", "query": "query ($class: String!, $return: Int) { switch(class: $class, return: $return) { class return } }", "variables": {"class": "v", "return": 9},
     "expect": {"data": {"switch": {"class": "v", "return": 9}}}},
    {"name": "keywords_underscore_operation", "query": "{ _status }",
     "expect": {"data": {"_status": "ok"}}},
    {"name": "keywords_reserved_input_full", "query": "mutation { echoReserved(input: {class: \"c\", return: 3, default: \"d\", is: true, synchronized: 1}) { class return default } }",
     "expect": {"data": {"echoReserved": {"class": "c", "return": 3, "default": "d"}}}},
    {"name": "keywords_reserved_input_minimal", "query": "mutation { echoReserved(input: {class: \"c\"}) { class return default } }",
     "expect": {"data": {"echoReserved": {"class": "c", "return": -1, "default": "none"}}}},
    {"name": "keywords_reserved_input_from_variable", "query": "mutation ($i: ReservedInput!) { echoReserved(input: $i) { class return default } }", "variables": {"i": {"class": "k", "return": 4, "default": "dv"}},
     "expect": {"data": {"echoReserved": {"class": "k", "return": 4, "default": "dv"}}}},

    {
      "name": "mutation_create_article",
      "query": "mutation { createArticle(input: {title: \"T1\", authorId: \"2\"}) { id title authorId published type webSite { id } author { id name } authorList { id } } }",
      "expect": {"data": {"createArticle": {"id": {"$any": true}, "title": "T1", "authorId": "2", "published": false, "type": null, "webSite": null, "author": {"id": "2", "name": "Alice"}, "authorList": [{"id": "2"}]}}}
    },
    {"name": "mutation_create_with_reserved_input_field", "query": "mutation { createArticle(input: {title: \"T2\", authorId: \"1\", class: \"k\"}) { title } }",
     "expect": {"data": {"createArticle": {"title": "T2"}}}},
    {
      "name": "mutation_aliases_and_double_delete",
      "steps": [
        {"query": "mutation { a: createArticle(input: {title: \"S1\", authorId: \"1\"}) { id } b: updateArticle(input: {id: \"3\", title: \"Alice's First Post\"}) { title } }",
         "expect": {"data": {"a": {"id": {"$any": true}}, "b": {"title": "Alice's First Post"}}}, "capture": {"a": "a.id"}},
        {"query": "mutation ($id: ID!) { d: deleteArticle(id: $id) again: deleteArticle(id: $id) }", "variables": {"id": "{{a}}"},
         "expect": {"data": {"d": true, "again": false}}}
      ]
    },
    {
      "name": "mutation_update_keeps_other_fields",
      "query": "mutation { updateArticle(input: {id: \"3\", title: \"Alice's First Post\"}) { id title authorId type published webSite { id } } }",
      "expect": {"data": {"updateArticle": {"id": "3", "title": "Alice's First Post", "authorId": "2", "type": "REVIEW", "published": true, "webSite": {"id": "3"}}}}
    },
    {"name": "mutation_update_without_title_keeps_title", "query": "mutation { updateArticle(input: {id: \"1\"}) { title } }",
     "expect": {"data": {"updateArticle": {"title": "GraphLink Basics"}}}},
    {"name": "mutation_update_unknown_errors", "query": "mutation { updateArticle(input: {id: \"missing\", title: \"x\"}) { id } }",
     "expect": {"errors": true, "data": null, "errorPath": ["updateArticle"]}},
    {
      "name": "mutation_create_then_delete",
      "steps": [
        {"query": "mutation { createArticle(input: {title: \"D\", authorId: \"1\"}) { id } }", "capture": {"id": "createArticle.id"},
         "expect": {"data": {"createArticle": {"id": {"$any": true}}}}},
        {"query": "query ($id: ID!) { getArticle(id: $id) { id title } }", "variables": {"id": "{{id}}"},
         "expect": {"data": {"getArticle": {"id": "{{id}}", "title": "D"}}}},
        {"query": "mutation ($id: ID!) { deleteArticle(id: $id) }", "variables": {"id": "{{id}}"},
         "expect": {"data": {"deleteArticle": true}}},
        {"query": "mutation ($id: ID!) { deleteArticle(id: $id) }", "variables": {"id": "{{id}}"},
         "expect": {"data": {"deleteArticle": false}}},
        {"query": "query ($id: ID!) { getArticle(id: $id) { id } }", "variables": {"id": "{{id}}"},
         "expect": {"errors": true, "data": null}}
      ]
    },
    {
      "name": "mutation_mapping_error_on_created_article",
      "steps": [
        {"query": "mutation { createArticle(input: {title: \"orphan\", authorId: \"999\"}) { id } }", "capture": {"id": "createArticle.id"},
         "expect": {"data": {"createArticle": {"id": {"$any": true}}}}},
        {"query": "query ($id: ID!) { getArticle(id: $id) { id author { id } } }", "variables": {"id": "{{id}}"},
         "expect": {"errors": true, "data": null, "errorPath": ["getArticle", "author"]}},
        {"query": "query ($id: ID!) { getArticle(id: $id) { id authorList { id } } }", "variables": {"id": "{{id}}"},
         "expect": {"data": {"getArticle": {"id": "{{id}}", "authorList": []}}}},
        {"query": "mutation ($id: ID!) { deleteArticle(id: $id) }", "variables": {"id": "{{id}}"},
         "expect": {"data": {"deleteArticle": true}}}
      ]
    },
    {"name": "bulk_nested_list_input", "query": "mutation { bulkCreate(matrix: [[{title: \"a\", authorId: \"1\"}, {title: \"b\", authorId: \"1\"}], [{title: \"c\", authorId: \"2\"}]]) }",
     "expect": {"data": {"bulkCreate": 3}}},
    {"name": "bulk_null_inner_list", "query": "mutation { bulkCreate(matrix: [[{title: \"a\", authorId: \"1\"}], null, []]) }",
     "expect": {"data": {"bulkCreate": 1}}},
    {"name": "bulk_null_and_omitted_matrix", "query": "mutation { a: bulkCreate(matrix: null) b: bulkCreate }",
     "expect": {"data": {"a": 0, "b": 0}}},
    {"name": "bulk_single_object_coerced_to_nested_list", "query": "mutation { bulkCreate(matrix: {title: \"a\", authorId: \"1\"}) }",
     "expect": {"data": {"bulkCreate": 1}}},
    {"name": "bulk_nested_list_from_variable", "query": "mutation ($m: [[CreateArticleInput!]]) { bulkCreate(matrix: $m) }",
     "variables": {"m": [[{"title": "a", "authorId": "1", "class": "x"}], [{"title": "b", "authorId": "2"}]]},
     "expect": {"data": {"bulkCreate": 2}}},
    {"name": "bulk_validate_guard_rejects", "query": "mutation { bulkCreate(matrix: [[{title: \"ok\", authorId: \"1\"}], [{title: \"invalid\", authorId: \"1\"}]]) }",
     "expect": {"errors": true, "data": null, "errorPath": ["bulkCreate"]}},
    {"name": "bulk_null_inside_non_null_inner_list_rejected", "query": "mutation { bulkCreate(matrix: [[null]]) }", "status": [200, 400],
     "expect": {"errors": true}},
    {"name": "mutation_send_greeting_not_intercepted", "query": "mutation { sendGreeting(name: \"m\") { message } }",
     "expect": {"data": {"sendGreeting": {"message": "Hello, m"}}}}
  ],
  "ws": [
    {
      "name": "ws_finite_stream_completes",
      "subscribe": [{"id": "d", "query": "subscription { articleDeleted }"}],
      "expect": {"d": {"next": [{"articleDeleted": "deleted-1"}, {"articleDeleted": "deleted-2"}], "complete": true}}
    },
    {
      "name": "ws_created_event_resolves_mappings",
      "subscribe": [{"id": "c", "query": "subscription { articleCreated { id title authorId author { id name } authorList { id } } }"}],
      "trigger": [{"query": "mutation { createArticle(input: {title: \"WS created\", authorId: \"2\"}) { id } }", "capture": {"id": "createArticle.id"},
                   "expect": {"data": {"createArticle": {"id": {"$any": true}}}}}],
      "expect": {"c": {"next": [{"articleCreated": {"id": "{{id}}", "title": "WS created", "authorId": "2", "author": {"id": "2", "name": "Alice"}, "authorList": [{"id": "2"}]}}], "complete": false}}
    },
    {
      "name": "ws_argument_filters_events",
      "setup": [
        {"query": "mutation { a: createArticle(input: {title: \"A\", authorId: \"1\"}) { id } b: createArticle(input: {title: \"B\", authorId: \"1\"}) { id } }",
         "capture": {"a": "a.id", "b": "b.id"}, "expect": {"data": {"a": {"id": {"$any": true}}, "b": {"id": {"$any": true}}}}}
      ],
      "subscribe": [{"id": "u", "query": "subscription ($id: ID!) { articleUpdated(id: $id) { id title } }", "variables": {"id": "{{b}}"}}],
      "trigger": [
        {"query": "mutation ($id: ID!) { updateArticle(input: {id: $id, title: \"A2\"}) { id } }", "variables": {"id": "{{a}}"}, "expect": {"data": {"updateArticle": {"id": "{{a}}"}}}},
        {"query": "mutation ($id: ID!) { updateArticle(input: {id: $id, title: \"B2\"}) { id } }", "variables": {"id": "{{b}}"}, "expect": {"data": {"updateArticle": {"id": "{{b}}"}}}}
      ],
      "expect": {"u": {"next": [{"articleUpdated": {"id": "{{b}}", "title": "B2"}}]}}
    },
    {
      "name": "ws_two_subscriptions_on_one_socket",
      "subscribe": [
        {"id": "c", "query": "subscription { articleCreated { title } }"},
        {"id": "g", "query": "subscription { greetingReceived { message } }"}
      ],
      "trigger": [
        {"query": "mutation { sendGreeting(name: \"ws\") { id } }", "expect": {"data": {"sendGreeting": {"id": "1"}}}},
        {"query": "mutation { createArticle(input: {title: \"multi\", authorId: \"1\"}) { id } }", "expect": {"data": {"createArticle": {"id": {"$any": true}}}}}
      ],
      "expect": {
        "c": {"next": [{"articleCreated": {"title": "multi"}}]},
        "g": {"next": [{"greetingReceived": {"message": "Hello, ws(runBefore)"}}]}
      }
    },
    {
      "name": "ws_complete_stops_only_that_subscription",
      "subscribe": [
        {"id": "stopped", "query": "subscription { articleCreated { title } }"},
        {"id": "live", "query": "subscription { articleCreated { title } }"}
      ],
      "stopBeforeTrigger": ["stopped"],
      "trigger": [{"query": "mutation { createArticle(input: {title: \"after stop\", authorId: \"1\"}) { id } }", "expect": {"data": {"createArticle": {"id": {"$any": true}}}}}],
      "quiet": 1.5,
      "expect": {"stopped": {"next": []}, "live": {"next": [{"articleCreated": {"title": "after stop"}}]}}
    },
    {
      "name": "ws_many_subscribers_each_get_the_event",
      "subscribe": [
        {"id": "s1", "query": "subscription { greetingReceived { message } }"},
        {"id": "s2", "query": "subscription { greetingReceived { message } }"},
        {"id": "s3", "query": "subscription { greetingReceived { id } }"}
      ],
      "trigger": [
        {"query": "mutation { sendGreeting(name: \"one\") { id } }", "expect": {"data": {"sendGreeting": {"id": "1"}}}},
        {"query": "mutation { sendGreeting(name: \"two\") { id } }", "expect": {"data": {"sendGreeting": {"id": "1"}}}}
      ],
      "expect": {
        "s1": {"next": [{"greetingReceived": {"message": "Hello, one(runBefore)"}}, {"greetingReceived": {"message": "Hello, two(runBefore)"}}]},
        "s2": {"next": [{"greetingReceived": {"message": "Hello, one(runBefore)"}}, {"greetingReceived": {"message": "Hello, two(runBefore)"}}]},
        "s3": {"next": [{"greetingReceived": {"id": "1"}}, {"greetingReceived": {"id": "1"}}]}
      }
    },
    {
      "name": "ws_query_operation_over_socket",
      "subscribe": [{"id": "q", "query": "{ getAuthor(id: \"2\") { name } }"}],
      "expect": {"q": {"next": [{"getAuthor": {"name": "Alice"}}], "complete": true}}
    },
    {
      "name": "ws_mutation_operation_over_socket",
      "subscribe": [{"id": "m", "query": "mutation { ackPriority(level: LOW) }"}],
      "expect": {"m": {"next": [{"ackPriority": "OK"}], "complete": true}}
    }
  ]
}
