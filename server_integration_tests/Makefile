# ---- Server fault suite (server_faults/): malformed and hostile requests against each server ----
# One fresh server per run. Known server defects live in server_faults/known_defects.json.

# ---- Server REST suite (server_rest/): the REST operations of schema_rest/rest.gql over raw HTTP ----

# ---- Server GraphQL suite (server_graphql/): exact data, schema, defaults and subscriptions over raw HTTP and WebSocket ----
# ci-http-<server> runs the three suites against one server start, which is what CI does.

define fault_rule
ci-faults-$(1): $(3) $(1)-start-server
	python3 -I server_faults/run_faults.py $(2) $(4) || ($(MAKE) $(1)-stop-server && exit 1)
	$(MAKE) $(1)-stop-server

ci-rest-$(1): $(3) $(1)-start-server
	python3 -I server_rest/run_rest.py $(2) $(4) || ($(MAKE) $(1)-stop-server && exit 1)
	$(MAKE) $(1)-stop-server

ci-graphql-$(1): $(3) $(1)-start-server
	python3 -I server_graphql/run_graphql.py $(2) $(4) || ($(MAKE) $(1)-stop-server && exit 1)
	$(MAKE) $(1)-stop-server

ci-openapi-$(1): $(3) $(1)-start-server
	python3 -I server_openapi/run_openapi.py $(2) $(4) || ($(MAKE) $(1)-stop-server && exit 1)
	$(MAKE) $(1)-stop-server

ci-http-$(1): $(3) $(1)-start-server
	status=0; \
	python3 -I server_faults/run_faults.py $(2) $(4) || status=1; \
	python3 -I server_rest/run_rest.py $(2) $(4) || status=1; \
	python3 -I server_openapi/run_openapi.py $(2) $(4) || status=1; \
	python3 -I server_graphql/run_graphql.py $(2) $(4) || status=1; \
	$(MAKE) $(1)-stop-server; \
	exit $$$$status
endef

$(eval $(call fault_rule,typescript,typescript_server,typescript-install,$(TS_PORT)))
$(eval $(call fault_rule,java,java_server,java-build,$(JAVA_PORT)))
$(eval $(call fault_rule,java-reactive,java_server_reactive,java-reactive-build,$(JAVA_PORT)))
$(eval $(call fault_rule,kotlin-blocking,kotlin_server_blocking,kotlin-build,$(KOTLIN_BLOCKING_PORT)))
$(eval $(call fault_rule,kotlin-suspend,kotlin_server_suspend,kotlin-build,$(KOTLIN_SUSPEND_PORT)))
$(eval $(call fault_rule,python-fastapi,python_fastapi_server,python-fastapi-install,$(PYTHON_FASTAPI_PORT)))
$(eval $(call fault_rule,python-django,python_django_server,python-django-install,$(PYTHON_DJANGO_PORT)))
$(eval $(call fault_rule,nestjs,nestjs_server,nestjs-install,$(NESTJS_PORT)))

# ---- Python servers generated from the GraphQL operations alone and from the REST operations alone ----
# GraphQL only: fault and GraphQL suites, and no REST route answers. REST only: REST suite, and no GraphQL endpoint answers.

define python_mode_rule
$(1)-install:
	$$(MAKE) -C servers/$(2) install

$(1)-start-server:
	$$(MAKE) -C servers/$(2) start-server

$(1)-stop-server:
	$$(MAKE) -C servers/$(2) stop-server

ci-http-$(1): $(1)-install $(1)-start-server
	status=0; \
	$(4) \
	$$(MAKE) $(1)-stop-server; exit $$$$status
endef

GRAPHQL_ONLY_SUITES = python3 -I server_faults/run_faults.py $(1) $(2) || status=1; GRAPHQL_ONLY=1 python3 -I server_graphql/run_graphql.py $(1) $(2) || status=1; python3 -I server_rest/run_rest.py $(1) $(2) graphql-only || status=1; python3 -I server_openapi/run_openapi.py $(1) $(2) graphql-only || status=1;
REST_ONLY_SUITES = python3 -I server_rest/run_rest.py $(1) $(2) rest-only || status=1; python3 -I server_openapi/run_openapi.py $(1) $(2) || status=1;

$(eval $(call python_mode_rule,python-fastapi-graphql,python_fastapi_graphql_server,$(PYTHON_FASTAPI_GRAPHQL_PORT),$(call GRAPHQL_ONLY_SUITES,python_fastapi_graphql_server,$(PYTHON_FASTAPI_GRAPHQL_PORT))))
$(eval $(call python_mode_rule,python-fastapi-rest,python_fastapi_rest_server,$(PYTHON_FASTAPI_REST_PORT),$(call REST_ONLY_SUITES,python_fastapi_rest_server,$(PYTHON_FASTAPI_REST_PORT))))
$(eval $(call python_mode_rule,python-django-graphql,python_django_graphql_server,$(PYTHON_DJANGO_GRAPHQL_PORT),$(call GRAPHQL_ONLY_SUITES,python_django_graphql_server,$(PYTHON_DJANGO_GRAPHQL_PORT))))
$(eval $(call python_mode_rule,python-django-rest,python_django_rest_server,$(PYTHON_DJANGO_REST_PORT),$(call REST_ONLY_SUITES,python_django_rest_server,$(PYTHON_DJANGO_REST_PORT))))

ci-http-python-modes: ci-http-python-fastapi ci-http-python-fastapi-graphql ci-http-python-fastapi-rest ci-http-python-django ci-http-python-django-graphql ci-http-python-django-rest

faults: ci-faults-typescript ci-faults-java ci-faults-java-reactive ci-faults-kotlin-blocking ci-faults-kotlin-suspend ci-faults-python-fastapi ci-faults-python-django ci-faults-nestjs

rest: ci-rest-typescript ci-rest-java ci-rest-java-reactive ci-rest-kotlin-blocking ci-rest-kotlin-suspend ci-rest-python-fastapi ci-rest-python-django ci-rest-nestjs

graphql: ci-graphql-typescript ci-graphql-java ci-graphql-java-reactive ci-graphql-kotlin-blocking ci-graphql-kotlin-suspend ci-graphql-python-fastapi ci-graphql-python-django ci-graphql-nestjs

http: ci-http-typescript ci-http-java ci-http-java-reactive ci-http-kotlin-blocking ci-http-kotlin-suspend ci-http-python-fastapi ci-http-python-django ci-http-nestjs

