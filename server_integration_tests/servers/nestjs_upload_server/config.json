{
  "schemaPaths": [
    "../../upload_schema/upload_schema.gql"
  ],
  "mode": "server",
  "typeMappings": {
    "ID": "string",
    "String": "string",
    "Float": "number",
    "Int": "number",
    "Boolean": "boolean",
    "Null": "null"
  },
  "outputDir": "src/generated",
  "serverConfig": {
    "nestApollo": {
      "port": 9927,
      "graphqlPath": "/graphql",
      "generateEntryPoint": true,
      "useResolveInfo": false
    }
  }
}
