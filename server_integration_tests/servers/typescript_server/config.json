{
  "schemaPaths": ["../../schema/*.gql", "../../schema_rest/*.gql", "../../schema_errors/*.gql"],
  "mode": "server",
  "typeMappings": {
    "ID":      "string",
    "String":  "string",
    "Float":   "number",
    "Int":     "number",
    "Boolean": "boolean",
    "Null":    "null"
  },
  "outputDir": "src/generated",
  "serverConfig": {
    "openapi": { "title": "GraphLink REST test", "version": "1.0.0" },
    "expressApollo": {
      "port": 9997,
      "graphqlPath": "/graphql",
      "generateEntryPoint": true,
      "useResolveInfo": true,
      "injectContext": true
    }
  }
}
