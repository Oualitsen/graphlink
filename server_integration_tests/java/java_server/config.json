{
  "schemaPaths": ["../../schema/schema.gql"],
  "mode": "server",
  "outputDir": "src/main/java/dev/graphlink/javaserver/generated",
  "typeMappings": {
        "ID": "String",
        "String": "String",
        "Float": "double",
        "Int": "int",
        "Boolean": "boolean",
        "Null": "null"
    },
  "serverConfig": {
    "spring": {
      "basePackage": "dev.graphlink.javaserver.generated",
      "reactive": false,
      "generateSchema": true,
      "schemaTargetPath": "src/main/resources/graphql/schema.graphqls",
      "immutableInputFields": true,
      "immutableTypeFields": false,
      "injectDataFetching": false
    }
  }
}
