{
  "schemaPaths": ["../schema/*.gql", "queries.gql"],
  "mode": "client",
  "typeMappings": {
    "ID":      "string",
    "String":  "string",
    "Float":   "number",
    "Int":     "number",
    "Boolean": "boolean",
    "Null":    "null"
  },
  "outputDir": "src/generated",
  "clientConfig": {
    "typescript": {
      "generateAllFieldsFragments": true,
      "autoGenerateQueries":       true,
      "optionalNullableInputFields": true,
      "immutableTypeFields":       true,
      "generateDefaultWsAdapter":  true,
      "httpAdapter":               "fetch"
    }
  }
}
