{
  "schemaPaths": ["../../schema/*.gql"],
  "mode": "server",
  "typeMappings": {
    "ID":      "string",
    "String":  "string",
    "Float":   "number",
    "Int":     "number",
    "Boolean": "boolean",
    "Null":    "null"
  },
  "outputDir": "src/generated",
  "serverConfig": {
    "expressApollo": {
      "port": 9997,
      "graphqlPath": "/graphql",
      "generateEntryPoint": true,
      "useResolveInfo": false
    }
  }
}
