  "ws": [
    {
      "name": "ws_subscribe_before_init",
      "send": [
        {
          "id": "1",
          "type": "subscribe",
          "payload": {
            "query": "subscription { articleCreated { id } }"
          }
        }
      ],
      "expectClose": [
        4401
      ]
    },
    {
      "name": "ws_unknown_message_type",
      "send": [
        "init",
        {
          "type": "bogus"
        }
      ],
      "expectClose": [
        4400
      ]
    },
    {
      "name": "ws_message_without_type",
      "send": [
        "init",
        {
          "id": "1"
        }
      ],
