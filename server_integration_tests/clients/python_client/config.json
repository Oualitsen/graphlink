{
  "schemaPaths": ["../../schema/*.gql", "queries.gql"],
  "mode": "client",
  "outputDir": "generated",
  "clientConfig": {
    "python": {
      "httpAdapter": "httpx",
      "wsAdapter": "websockets",
      "generateAllFieldsFragments": true,
      "autoGenerateQueries": true,
      "nullableFieldsRequired": false,
      "immutableTypeFields": true,
      "captureErrors": false
    }
  }
}
