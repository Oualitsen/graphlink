{
  "schemaPaths": [
    "../../../mock/schema_mock/schema.gql",
    "../../../mock/schema_mock/custom_query.graphql",
    "../../schema/persisted_queries.graphql"
  ],
  "mode": "client",
  "typeMappings": {
    "ID": "String",
    "String": "String",
    "Float": "Double",
    "Int": "Integer",
    "Boolean": "Boolean",
    "Null": "null"
  },
  "outputDir": "client-app/src/main/java/dev/graphlink/test/generated",
  "clientConfig": {
    "java": {
      "packageName": "dev.graphlink.test.generated",
      "wsAdapter": "java11",
      "jsonCodec": "jackson",
      "generateAllFieldsFragments": true,
      "autoGenerateQueries": true,
      "nullableFieldsRequired": false,
      "immutableInputFields": true,
      "immutableTypeFields": true,
      "inputAsRecord": false,
      "typeAsRecord": false,
      "captureErrors": false,
      "persistedQueries": "apq",
      "persistedQueriesUseGet": true,
      "asyncStyle": "reactor",
      "reactiveHttpClient": "webclient"
    }
  }
}
