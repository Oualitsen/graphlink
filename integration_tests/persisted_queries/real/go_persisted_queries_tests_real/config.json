{
  "schemaPaths": [
    "../../../real/schema_real/schema.gql",
    "../../schema/persisted_queries.graphql"
  ],
  "mode": "client",
  "typeMappings": {
    "DateTime": "string",
    "LocalDate": "string",
    "BigDecimal": "any",
    "JSON": "any",
    "Opaque": {
      "type": "string",
      "fromJson": "\"opaque:\" + {}.(string)",
      "toJson": "strings.TrimPrefix({}, \"opaque:\")"
    }
  },
  "outputDir": "generated",
  "clientConfig": {
    "go": {
      "packageName": "generated",
      "generateAllFieldsFragments": true,
      "autoGenerateQueries": true,
      "captureErrors": false,
      "persistedQueries": "apq",
      "persistedQueriesUseGet": true
    }
  }
}
