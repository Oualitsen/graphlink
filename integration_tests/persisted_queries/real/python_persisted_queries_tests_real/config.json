{
  "schemaPaths": [
    "../../../real/schema_real/schema.gql",
    "../../schema/persisted_queries.graphql"
  ],
  "mode": "client",
  "typeMappings": {
    "DateTime": "str",
    "LocalDate": "str",
    "BigDecimal": "Any",
    "JSON": "Any",
    "Opaque": {
      "type": "str",
      "fromJson": "\"opaque:\" + {}",
      "toJson": "{}[7:]"
    }
  },
  "outputDir": "generated",
  "clientConfig": {
    "python": {
      "httpAdapter": "httpx",
      "wsAdapter": "websockets",
      "generateAllFieldsFragments": true,
      "autoGenerateQueries": true,
      "nullableFieldsRequired": false,
      "immutableTypeFields": true,
      "captureErrors": false,
      "persistedQueries": "apq",
      "persistedQueriesUseGet": true
    }
  }
}
