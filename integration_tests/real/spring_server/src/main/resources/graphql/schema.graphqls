enum EventType {
  pending
  in_progress
  completed_ok
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  ADMIN
  USER
  GUEST
}

# ── Enum spellings and list shapes ───────────────────────────────────────────

enum Spelling {
  A
  B2
  x__y
  http2_ok
  v1
  snake_case_2
}

enum OnlyOne {
  ONLY
}

enum ArgOnly {
  P1
  P2
}

enum RespOnly {
  R1
  R2
}

enum Phase {
  OPEN
  CLOSED
  ARCHIVED
}

type PhaseProbe {
  single: Phase!
  maybe: Phase
  list: [Phase!]!
  nullableList: [Phase]
}

type Phased {
  phase: Phase!
}

type Plain {
  id: ID!
}

union PhaseHolder = Phased | Plain

# ── Identifiers ──────────────────────────────────────────────────────────────

type Reserved {
  type: String!
  default: String!
  in: String!
  is: String!
  var: String!
  val: String!
  fun: String!
  new: String!
  import: String!
  return: String!
  object: String!
  from: String!
  None: String!
  True: String!
  func: String!
  range: String!
  self: String!
  Self: String!
  init: String!
  Type: String!
  Protocol: String!
  async: String!
  await: String!
  package: String!
  interface: String!
  enum: String!
  null: String!
}

input ReservedInput {
  type: String!
  default: String!
  in: String!
  is: String!
  var: String!
  val: String!
  fun: String!
  new: String!
  import: String!
  return: String!
  object: String!
  from: String!
  None: String!
  True: String!
  func: String!
  range: String!
  self: String!
  Self: String!
  init: String!
  Type: String!
  Protocol: String!
  async: String!
  await: String!
  package: String!
  interface: String!
  enum: String!
  null: String!
}

enum Literal {
  default
  class
  None
  True
  nil
  undefined
  NaN
  self
}

type Error {
  id: ID!
}

type Response {
  id: ID!
}

type Request {
  id: ID!
}

type List {
  id: ID!
}

type Map {
  id: ID!
}

type Object {
  id: ID!
}

type Optional {
  id: ID!
}

type Date {
  id: ID!
}

type Result {
  id: ID!
}

type Void {
  id: ID!
}

type Clashes {
  error: Error!
  response: Response!
  request: Request!
  list: List!
  map: Map!
  object: Object!
  optional: Optional!
  date: Date!
  result: Result!
  void: Void!
}

type Odd {
  user_id: String!
  userId: String!
  URLValue: String!
  HTTPServer: String!
  _leading: String!
  trailing_: String!
  v2_name: String!
  isActive: String!
  active: String!
  getX: String!
  x: String!
}

input OddInput {
  user_id: String!
  userId: String!
  URLValue: String!
  HTTPServer: String!
  _leading: String!
  trailing_: String!
  v2_name: String!
  isActive: String!
  active: String!
  getX: String!
  x: String!
}

# ── Nested field arguments ───────────────────────────────────────────────────

type Shelf {
  id: ID!
  items(tags: [String!], kind: Spelling, filter: InnerInput, limit: Int = 2): [String!]!
}

# ── Literals, defaults and escaping ──────────────────────────────────────────

input NastyInput {
  dollar: String
  quote: String
  backslash: String
  newline: String
  percent: String
  comments: String
  triple: String
  unicode: String
  nonAscii: String
}

type NastyEcho {
  dollar: String
  quote: String
  backslash: String
  newline: String
  percent: String
  comments: String
  triple: String
  unicode: String
  nonAscii: String
}

input InnerInput {
  n: Int
  label: String
  tags: [String!]
}

type InnerEcho {
  n: Int
  label: String
  tags: [String!]
}

input EverythingInput {
  i: Int
  neg: Int
  big: Int
  f: Float
  exp: Float
  b: Boolean
  bf: Boolean
  s: String
  id: ID
  e: Spelling
  ints: [Int!]
  nested: [[Int!]!]
  inner: InnerInput
  nothing: String
  emptyList: [String!]
  emptyObj: InnerInput
}

type EverythingEcho {
  i: Int
  neg: Int
  big: Int
  f: Float
  exp: Float
  b: Boolean
  bf: Boolean
  s: String
  id: ID
  e: Spelling
  ints: [Int!]
  nested: [[Int!]!]
  inner: InnerEcho
  nothing: String
  emptyList: [String!]
  emptyObj: InnerEcho
}

input Tree {
  value: Int!
  children: [Tree!]
}

input Ping {
  n: Int!
  pong: Pong
}

input Pong {
  n: Int!
  ping: Ping
}

type TreeStats {
  flat: [Int!]!
  depth: Int!
}

input Pet @oneOf {
  cat: String
  dog: Int
}

enum Mood {
  CALM
  RELAXED
  ANGRY
}

type Legacy {
  id: ID!
  old: String
  older: String
  mood: Mood
}

type ListShapes {
  a: [Int!]!
  b: [Int!]
  c: [Int]!
  d: [Int]
  e: [[Int!]!]!
  f: [[Int]]
  g: [Spelling]!
  h: [Photo]!
  i: [Attachment]!
  j: [Entity]!
}

type ListsEcho {
  a: [Int!]!
  b: [Int]
  c: [[Int!]!]
  e: [Spelling!]!
  f: [Spelling]
  g: [Spelling!]
  one: OnlyOne!
}

input ListsInput {
  a: [Int!]!
  b: [Int]
  c: [[Int!]!]
  e: [Spelling!]!
  f: [Spelling]
  g: [Spelling!] = [A, B2]
  one: OnlyOne = ONLY
}

type AllScalars {
  id:            ID!
  strVal:        String!
  intVal:        Int!
  floatVal:      Float!
  boolVal:       Boolean!
  nullableStr:   String
  nullableInt:   Int
  nullableFloat: Float
  nullableBool:  Boolean
  nullableId:    ID
}

type Address {
  street:  String!
  city:    String!
  country: String!
  zip:     String
}

type User {
  id:             ID!
  name:           String!
  email:          String!
  status:         UserStatus!
  priority:       Priority
  address:        Address!
  billingAddress: Address
  tags:           [String!]!
  scores:         [Int!]
  posts:          [Post!]
}

type Post {
  id:        ID!
  title:     String!
  body:      String!
  author:    User!
  coAuthor:  User
  viewCount: Int!
}

type Tag {
  id:    ID!
  label: String!
  color: String
}

type AuditEntry {
  id:           ID!
  action:       String!
  performedBy:  String!
  internalNote: String!
}

interface SearchResult {
  id: ID!
}

type UserResult implements SearchResult {
  id:    ID!
  name:  String!
  email: String!
}

type PostResult implements SearchResult {
  id:    ID!
  title: String!
}

type DefaultsEcho {
  name:      String!
  role:      Role!
  age:       Int!
  isActive:  Boolean!
  score:     Float!
  nickname:  String!
  tags:      [String]!
}

type NestedDefaultsEcho {
  name:     String!
  address:  Address
  contacts: [Address]
  matrix:   [[Address]]
}

type Driver {
  id: ID!
  lastUsedMillage(odometerKm: Int!): Int!
  lastUsedFuel(liters: Int!): Int!
}

# ── Polymorphism coverage ─────────────────────────────────────────────────────

union Attachment = Photo | Video | Document

type Phone  { id: ID! size: Int! model: String! }
type Laptop { id: ID! size: String! cpu: String! }
union Gadget = Phone | Laptop
union Shareable = Photo | Phone

type Photo    { id: ID! url: String! width: Int! }
type Video    { id: ID! url: String! seconds: Int! }
type Document { id: ID! url: String! pages: Int! }

interface Listing {
  id:      ID!
  title:   String!
  items(limit: Int!): [Attachment!]!
  related: Listing
}

type Album implements Listing {
  id:      ID!
  title:   String!
  items(limit: Int!): [Attachment!]!
  related: Listing
  year:    Int!
}

type Playlist implements Listing {
  id:      ID!
  title:   String!
  items(limit: Int!): [Attachment!]!
  related: Listing
  tracks:  Int!
}

union Solo = Album

interface Node { id: ID! }
interface Entity implements Node { id: ID! createdBy: String! }

type Article implements Entity & Node {
  id:          ID!
  createdBy:   String!
  title:       String!
  cover:       Attachment
  attachments: [Attachment!]!
  related:     [Entity]
}

type Comment implements Entity & Node {
  id:        ID!
  createdBy: String!
  text:      String!
  parent:    Entity
}

# ── Identifier normalization coverage ────────────────────────────────────────
type NormalizedFields {
  id:         ID!
  FirstName:  String!
  last_name:  String!
  USER_AGE:   Int!
  event_type: EventType!
}

input NormalizedInput {
  FirstName:  String!
  last_name:  String!
  event_type: EventType!
}

# ── Keyword-collision coverage ────────────────────────────────────────────────
# `class` is reserved in Dart, Java, Kotlin, and TypeScript (parameter position).
# Exercised as a type field, an input field, a top-level query argument, and a
# query operation name. The wire name stays `class`; only generated identifiers
# are sanitized.
type ClassResult {
  id:    ID!
  class: String!
}

input ClassInput {
  class: String!
}

input AddressInput {
  street:  String!
  city:    String!
  country: String!
  zip:     String
}

input CreateUserInput {
  name:           String!
  email:          String!
  status:         UserStatus!
  priority:       Priority
  address:        AddressInput!
  billingAddress: AddressInput
  tags:           [String!]
  initialScore:   Int
}

input UpdateUserInput {
  name:     String
  email:    String
  status:   UserStatus
  priority: Priority
  tags:     [String!]
}

input CreateWithDefaultsInput {
  name:     String!
  role:     Role
  age:      Int
  isActive: Boolean
  score:    Float
  nickname: String
  tags:     [String]
}

input NestedDefaultsInput {
  name:     String!
  address:  AddressInput
  contacts: [AddressInput]
  matrix:   [[AddressInput]]
}

interface Vehicle {
  id: ID!
  owner: VehicleOwner!
}

type Car implements Vehicle {
  id: ID!
  model: String!
  owner: VehicleOwner!
}

type Bike implements Vehicle {
  id: ID!
  brand: String!
  owner: VehicleOwner!
}

type VehicleOwner {
  id: ID!
  name: String!
  driver: VehicleDriver!
}

type VehicleDriver {
  id: ID!
  name: String!
  vehicle: Vehicle
}

type Query {
  getUser(id: ID!): User!
  findUser(id: ID!): User
  listUsers: [User!]!
  listUsersByStatus(status: UserStatus!): [User!]!
  searchUsers(name: String!, limit: Int!): [User!]!
  getAllScalars(id: ID!): AllScalars!
  getPost(id: ID!): Post!
  getTags: [Tag!]!
  getAuditEntry(id: ID!): AuditEntry!
  search(term: String!): [SearchResult!]!
  getCachedUser(id: ID!): User!
  listCachedUsers: [User!]!
  getCachedPost(id: ID!): Post!
  getCachedConfig: AllScalars!
  getStaleUser(id: ID!): User
  getUserOrErrors(id: ID!): User!
  findUserOrErrors(id: ID!): User
  listUsersWithDefaults(limit: Int, role: Role): [User]!
  getDriver(id: ID!): Driver!
  getVehicleDriver(id: ID!): VehicleDriver!
  class(class: ID!): ClassResult!
  getNormalizedRecord(id: ID!): NormalizedFields!

  # Polymorphism coverage.
  feed: [Entity!]!
  node(id: ID!): Node
  attachment(id: ID!): Attachment
  attachments: [Attachment!]!
  attachmentsNullable: [Attachment]
  article(id: ID!): Article!
  getCachedAttachment(id: ID!): Attachment
  getCachedNode(id: ID!): Node
  attachmentOrErrors(id: ID!): Attachment
  gadget(id: ID!): Gadget
  gadgets: [Gadget!]!
  shareable(id: ID!): Shareable
  photo(id: ID!): Photo
  listing(id: ID!): Listing
  listings: [Listing!]!
  solo: Solo
  listShapes(mode: String!): ListShapes!
  bigInts(n: Int!): [Int!]!
  bigPhotos(n: Int!): [Photo!]!
  echoArgs(a: [Int!]!, b: [Int], c: [[Int!]!], e: [Spelling!]!, f: [Spelling], g: [Spelling!] = [A, B2], one: OnlyOne = ONLY): ListsEcho!
  echoInput(input: ListsInput!): ListsEcho!
  argOnly(v: ArgOnly!): String!
  respOnly: RespOnly!
  phaseProbe: PhaseProbe!
  phaseHolder: PhaseHolder!
  reservedEcho(type: String!, default: String!, in: String!, is: String!, var: String!, val: String!, fun: String!, new: String!, import: String!, return: String!, object: String!, from: String!, None: String!, True: String!, func: String!, range: String!, self: String!, Self: String!, init: String!, Type: String!, Protocol: String!, async: String!, await: String!, package: String!, interface: String!, enum: String!, null: String!): Reserved!
  reservedEchoInput(input: ReservedInput!): Reserved!
  literalEcho(v: Literal!, all: [Literal!]!): Literal!
  literals: [Literal!]!
  clashes: Clashes!
  oddEcho(input: OddInput!): Odd!
  import(value: String!): String!
  default(value: String!): String!
  new(value: String!): String!
  func(value: String!): String!
  None(value: String!): String!
  self(value: String!): String!
  shelf: Shelf!
  echoNastyArgs(dollar: String, quote: String, backslash: String, newline: String, percent: String, comments: String, triple: String, unicode: String, nonAscii: String): NastyEcho!
  echoNasty(input: NastyInput): NastyEcho!
  echoInner(inner: InnerInput): InnerEcho!
  echoEverything(input: EverythingInput!): EverythingEcho!
  treeStats(tree: Tree!): TreeStats!
  pingLength(ping: Ping!): Int!
  describePet(pet: Pet!): String!
  legacy(withReason: String, plain: String): Legacy!
}

type Mutation {
  createUser(input: CreateUserInput!): User!
  deleteUser(id: ID!): Boolean!
  updateUser(id: ID!, input: UpdateUserInput!): User!
  createCachedUser(input: CreateUserInput!): User!
  transferPost(postId: ID!, newAuthorId: ID!): Post!
  resetAll: Boolean!
  evictAttachments: Boolean!
  evictNodes: Boolean!
  createUserOrErrors(input: CreateUserInput!): User!
  createWithDefaults(input: CreateWithDefaultsInput!): DefaultsEcho!
  createWithNestedDefaults(input: NestedDefaultsInput!): NestedDefaultsEcho!
  makeClass(input: ClassInput!): ClassResult!
  createNormalizedRecord(input: NormalizedInput!): NormalizedFields!

  # Polymorphism coverage: kind is photo, video or document.
  addAttachment(articleId: ID!, url: String!, kind: String!): Attachment!
}

type Subscription {
  userCreated: User!
  userCreateds(ids: [ID!]!): [User!]
  userStatusChanged(userId: ID!): User!
  counterTick: Int!

  # Polymorphism coverage: emits a Photo, a Video, then a Document.
  attachmentAdded: Attachment!

  # Polymorphism coverage: emits an Article, then a Comment.
  entityPublished: Entity!
}
