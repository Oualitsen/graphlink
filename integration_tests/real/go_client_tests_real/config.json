{
  "schemaPaths": ["../schema_real/schema.gql", "../schema_real/custom_query.graphql"],
  "mode": "client",
  "typeMappings": {
    "DateTime": "string",
    "LocalDate": "string",
    "BigDecimal": "any",
    "JSON": "any",
    "Opaque": {"type": "string", "jsonType": "String", "fromJson": "\"opaque:\" + {}", "toJson": "strings.TrimPrefix({}, \"opaque:\")"}
  },
  "outputDir": "generated",
  "clientConfig": {
    "go": {
      "packageName": "generated",
      "generateAllFieldsFragments": true,
      "autoGenerateQueries": true,
      "captureErrors": false
    }
  }
}
