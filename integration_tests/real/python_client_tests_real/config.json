{
  "schemaPaths": ["../schema_real/schema.gql", "../schema_real/custom_query.graphql"],
  "mode": "client",
  "typeMappings": {
    "DateTime": "str",
    "LocalDate": "str",
    "BigDecimal": "Any",
    "JSON": "Any",
    "Opaque": {"type": "str", "jsonType": "String", "fromJson": "\"opaque:\" + {}", "toJson": "{}[7:]"}
  },
  "outputDir": "generated",
  "clientConfig": {
    "python": {
      "httpAdapter": "httpx",
      "wsAdapter": "websockets",
      "generateAllFieldsFragments": true,
      "autoGenerateQueries": true,
      "nullableFieldsRequired": false,
      "immutableTypeFields": true,
      "captureErrors": false
    }
  }
}
