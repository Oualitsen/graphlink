{
  "schemaPaths": ["../schema_real/schema.gql", "../schema_real/custom_query.graphql"],
  "mode": "client",
  "typeMappings": {
    "ID":      "string",
    "String":  "string",
    "Float":   "number",
    "Int":     "number",
    "Boolean": "boolean",
    "Null":    "null",
    "Long": "number",
    "DateTime": "string",
    "LocalDate": "string",
    "BigDecimal": "unknown",
    "JSON": "unknown",
    "Opaque": {"type": "string", "jsonType": "String", "fromJson": "\"opaque:\" + {}", "toJson": "{}.slice(7)"}
  },
  "outputDir": "lib/generated",
  "clientConfig": {
    "typescript": {
      "generateAllFieldsFragments": true,
      "autoGenerateQueries":        true,
      "httpAdapter":                "none",
      "immutableTypeFields":        true,
      "optionalNullableInputFields": true,
      "generateDefaultWsAdapter":   true
    }
  }
}
