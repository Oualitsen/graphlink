enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

type AllScalars {
  id:            ID!
  strVal:        String!
  intVal:        Int!
  floatVal:      Float!
  boolVal:       Boolean!
  nullableStr:   String
  nullableInt:   Int
  nullableFloat: Float
  nullableBool:  Boolean
  nullableId:    ID
}

type Address {
  street:  String!
  city:    String!
  country: String!
  zip:     String
}

type User {
  id:             ID!
  name:           String!
  email:          String!
  status:         UserStatus!
  priority:       Priority
  address:        Address!
  billingAddress: Address
  tags:           [String!]!
  scores:         [Int!]
  posts:          [Post!]
}

type Post {
  id:        ID!
  title:     String!
  body:      String!
  author:    User!
  coAuthor:  User
  viewCount: Int!
}

type Tag {
  id:    ID!
  label: String!
  color: String
}

type AuditEntry {
  id:           ID!
  action:       String!
  performedBy:  String!
  internalNote: String!
}

interface SearchResult {
  id: ID!
}

type UserResult implements SearchResult {
  id:    ID!
  name:  String!
  email: String!
}

type PostResult implements SearchResult {
  id:    ID!
  title: String!
}

input AddressInput {
  street:  String!
  city:    String!
  country: String!
  zip:     String
}

input CreateUserInput {
  name:           String!
  email:          String!
  status:         UserStatus!
  priority:       Priority
  address:        AddressInput!
  billingAddress: AddressInput
  tags:           [String!]
  initialScore:   Int
}

input UpdateUserInput {
  name:     String
  email:    String
  status:   UserStatus
  priority: Priority
  tags:     [String!]
}

type Query {
  getUser(id: ID!): User!
  findUser(id: ID!): User
  listUsers: [User!]!
  listUsersByStatus(status: UserStatus!): [User!]!
  searchUsers(name: String!, limit: Int!): [User!]!
  getAllScalars(id: ID!): AllScalars!
  getPost(id: ID!): Post!
  getTags: [Tag!]!
  getAuditEntry(id: ID!): AuditEntry!
  search(term: String!): [SearchResult!]!
  getCachedUser(id: ID!): User!
  listCachedUsers: [User!]!
  getCachedPost(id: ID!): Post!
  getCachedConfig: AllScalars!
  getStaleUser(id: ID!): User
  getUserOrErrors(id: ID!): User!
  findUserOrErrors(id: ID!): User
}

type Mutation {
  createUser(input: CreateUserInput!): User!
  deleteUser(id: ID!): Boolean!
  updateUser(id: ID!, input: UpdateUserInput!): User!
  createCachedUser(input: CreateUserInput!): User!
  transferPost(postId: ID!, newAuthorId: ID!): Post!
  resetAll: Boolean!
  createUserOrErrors(input: CreateUserInput!): User!
}

type Subscription {
  userCreated: User!
  userCreateds(ids: [ID!]!): [User!]
  userStatusChanged(userId: ID!): User!
}
