{
  "schemaPaths": [
    "schema.graphql"
  ],
  "mode": "server",
  "mapperStyle": "class",
  "typeMappings": {
    "ID": "string",
    "String": "string",
    "Float": "number",
    "Int": "number",
    "Boolean": "boolean",
    "Null": "null"
  },
  "outputDir": "lib/generated_nest",
  "serverConfig": {
    "nestApollo": {
      "port": 1
    }
  }
}
