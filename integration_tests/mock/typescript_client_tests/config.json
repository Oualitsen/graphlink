{
  "schemaPaths": ["../schema_mock/schema.gql", "../schema_mock/custom_query.graphql"],
  "mode": "client",
  "typeMappings": {
    "ID":      "string",
    "String":  "string",
    "Float":   "number",
    "Int":     "number",
    "Boolean": "boolean",
    "Null":    "null"
  },
  "outputDir": "lib/generated",
  "clientConfig": {
    "typescript": {
      "generateAllFieldsFragments": true,
      "autoGenerateQueries":        true,
      "httpAdapter":                "none",
      "immutableTypeFields":        true,
      "optionalNullableInputFields": true,
      "generateDefaultWsAdapter":   true
    }
  }
}
