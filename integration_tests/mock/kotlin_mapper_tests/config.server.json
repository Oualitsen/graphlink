{
  "schemaPaths": [
    "schema.graphql"
  ],
  "mode": "server",
  "mapperStyle": "class",
  "typeMappings": {
    "ID": "String",
    "String": "String",
    "Float": "Double",
    "Int": "Int",
    "Boolean": "Boolean"
  },
  "outputDir": "client-app/src/main/kotlin/dev/graphlink/mappermock/generatedserver",
  "serverConfig": {
    "kotlinSpring": {
      "basePackage": "dev.graphlink.mappermock.generatedserver",
      "generateControllers": false
    }
  }
}
